{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://albumasu.com/schemas/cloudflare-security.schema.json",
  "title": "AlbumASU Cloudflare security baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["zone", "settings", "customRules", "rateLimitingRules", "origin"],
  "properties": {
    "$schema": { "type": "string" },
    "zone": { "type": "string", "const": "albumasu.com" },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sslMode", "minimumTlsVersion", "alwaysUseHttps", "botFightMode", "browserIntegrityCheck"],
      "properties": {
        "sslMode": { "type": "string", "const": "strict" },
        "minimumTlsVersion": { "type": "string", "const": "1.2" },
        "alwaysUseHttps": { "type": "boolean" },
        "botFightMode": { "type": "boolean" },
        "browserIntegrityCheck": { "type": "boolean" }
      }
    },
    "customRules": { "$ref": "#/$defs/rules" },
    "rateLimitingRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/rule" },
          {
            "type": "object",
            "required": ["characteristics", "requestsPerPeriod", "periodSeconds", "mitigationTimeoutSeconds"]
          }
        ]
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "directHostnameExposure", "compensatingControls", "configurationFile"],
      "properties": {
        "provider": { "type": "string" },
        "directHostnameExposure": { "type": "string", "const": "accepted" },
        "compensatingControls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "configurationFile": { "type": "string" }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["name", "action", "expression"],
      "properties": {
        "name": { "type": "string" },
        "action": { "type": "string", "enum": ["block", "challenge", "managed_challenge"] },
        "expression": { "type": "string" },
        "characteristics": { "type": "array", "items": { "type": "string" } },
        "requestsPerPeriod": { "type": "integer", "minimum": 1 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "mitigationTimeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  }
}
