{
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/results",
      "redirect": "/vote",
      "statusCode": 301
    },
    {
      "route": "/account",
      "rewrite": "/account/index.html",
      "headers": {
        "Cache-Control": "no-store, no-transform"
      }
    },
    {
      "route": "/admin",
      "rewrite": "/admin/index.html",
      "headers": {
        "Cache-Control": "no-store, no-transform"
      }
    },
    {
      "route": "/reset-password",
      "rewrite": "/reset-password/index.html",
      "headers": {
        "Cache-Control": "no-store, no-transform"
      }
    },
    {
      "route": "/confirm-signup",
      "rewrite": "/confirm-signup/index.html",
      "headers": {
        "Cache-Control": "no-store, no-transform"
      }
    },
    {
      "route": "/about",
      "rewrite": "/about/index.html"
    },
    {
      "route": "/archive",
      "rewrite": "/archive/index.html"
    },
    {
      "route": "/current",
      "rewrite": "/current/index.html"
    },
    {
      "route": "/events",
      "rewrite": "/events/index.html"
    },
    {
      "route": "/privacy",
      "rewrite": "/privacy/index.html"
    },
    {
      "route": "/vote",
      "rewrite": "/vote/index.html"
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "trailingSlash": "never",
  "globalHeaders": {
    "Cache-Control": "public, must-revalidate, max-age=30, no-transform",
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://itunes.apple.com https://challenges.cloudflare.com; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' data: blob: https://*.mzstatic.com https://*.supabase.co https://*.bcbits.com; manifest-src 'self'; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
